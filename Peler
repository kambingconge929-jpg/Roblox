-- Fungsi Remote Finder Game
local function getRemote(nameKeyword)
    for _, v in pairs(ReplicatedStorage:GetDescendants()) do
        if v:IsA("RemoteEvent") and v.Name:lower():find(nameKeyword) then
            return v
        end
    end
    return nil
end

-- 1. Auto Rebirth Logic
task.spawn(function()
    while task.wait(1) do
        if getgenv().ShikiRebirth then
            pcall(function()
                local rebirthRemote = getRemote("rebirth") or getRemote("kelahiran") or getRemote("upgrade")
                if rebirthRemote then
                    rebirthRemote:FireServer()
                end
            end)
        end
    end
end)

-- 2. Speed Boost Logic
RunService.Heartbeat:Connect(function()
    if getgenv().ShikiSpeed then
        pcall(function()
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("Humanoid") then
                char.Humanoid.WalkSpeed = 65
            end
        end)
    end
end)

-- Fungsi Pembuat Tombol ala SAMP Dialog List Button
local function CreateButton(name, posY, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.92, 0, 0, 40)
    btn.Position = UDim2.new(0.04, 0, 0, posY)
    btn.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
    btn.BorderColor3 = Color3.fromRGB(0, 170, 255)
    btn.BorderSizePixel = 1
    btn.Text = " { 0xFFFFFFFF }" .. name .. " : [ OFF ]"
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextScaled = true
    btn.Font = Enum.Font.Code
    btn.Parent = MainFrame

    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 4)
    btnCorner.Parent = btn

    local active = false
    btn.MouseButton1Click:Connect(function()
        active = not active
        if active then
            btn.BackgroundColor3 = Color3.fromRGB(0, 150, 0)
            btn.Text = " { 0x00FF00FF }" .. name .. " : [ ON ]"
        else
            btn.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
            btn.Text = " { 0xFFFFFFFF }" .. name .. " : [ OFF ]"
        end
        callback(active)
    end)
end

-- Pasang Tombol-Tombol Shiki Hub
