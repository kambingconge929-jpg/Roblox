-- 1. Anti-AFK Fix (Simulasi klik virtual yang aman)
task.spawn(function()
    while task.wait(15) do
        if getgenv().ToggleAntiAFK then
            pcall(function()
                VirtualUser:Button2Down(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
                task.wait(1)
                VirtualUser:Button2Up(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
            end)
        end
    end
end)

-- 2. Auto Rebirth Fix (Mencari tombol UI asli game untuk diklik otomatis lewat VirtualUser / ClickDetector)
task.spawn(function()
    while task.wait(1) do
        if getgenv().AutoRebirth then
            pcall(function()
                -- Menembak atau mencari event rebirth di dalam game
                for _, v in pairs(game:GetDescendants()) do
                    if v:IsA("RemoteEvent") and (v.Name:lower():find("rebirth") or v.Name:lower():find("kelahiran")) then
                        v:FireServer()
                    end
                end
            end)
        end
    end
end)

-- 3. Speed Boost Fix (Memakai HeartService agar kecepatan lari dikunci terus di 60)
RunService.Heartbeat:Connect(function()
    if getgenv().ToggleSpeed then
        pcall(function()
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("Humanoid") then
                char.Humanoid.WalkSpeed = 60
            end
        end)
    end
end)

-- Fungsi Pembuat Tombol Toggle
local function CreateButton(name, posY, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.92, 0, 0, 40)
    btn.Position = UDim2.new(0.04, 0, 0, posY)
    btn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    btn.Text = name .. " : [ OFF ]"
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextScaled = true
    btn.Font = Enum.Font.SourceSansBold
    btn.Parent = MainFrame

    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 6)
    btnCorner.Parent = btn

    local active = false
    btn.MouseButton1Click:Connect(function()
        active = not active
        if active then
            btn.BackgroundColor3 = Color3.fromRGB(0, 180, 0)
            btn.Text = name .. " : [ ON ]"
        else
            btn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
            btn.Text = name .. " : [ OFF ]"
        end
        callback(active)
    end)
end

