-- 1. Anti-AFK Fix
task.spawn(function()
    while task.wait(1) do
        if getgenv().ToggleAntiAFK then
            pcall(function()
                VirtualUser:Button2Down(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
                task.wait(1)
                VirtualUser:Button2Up(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
            end)
        end
    end
end)

-- 2. Auto Rebirth Fix
task.spawn(function()
    while task.wait(0.5) do
        if getgenv().AutoRebirth then
            pcall(function()
                for _, v in pairs(game:GetDescendants()) do
                    if v:IsA("RemoteEvent") and (v.Name:lower():find("rebirth") or v.Name:lower():find("kelahiran") or v.Name:lower():find("upgrade")) then
                        v:FireServer()
                    end
                end
            end)
        end
    end
end)

-- 3. Speed Boost Fix
task.spawn(function()
    while task.wait(0.2) do
        if getgenv().ToggleSpeed then
            pcall(function()
                if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
                    LocalPlayer.Character.Humanoid.WalkSpeed = 60
                end
            end)
        else
            pcall(function()
                if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") and LocalPlayer.Character.Humanoid.WalkSpeed == 60 then
                    LocalPlayer.Character.Humanoid.WalkSpeed = 16
                end
            end)
        end
    end
end)

-- Fungsi Tombol Toggle Fitur
local function CreateButton(name, posY, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.9, 0, 0, 38)
    btn.Position = UDim2.new(0.05, 0, 0, posY)
    btn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
    btn.Text = name .. " : OFF"
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextScaled = true
    btn.Font = Enum.Font.SourceSansBold
    btn.Parent = MainFrame

    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 6)
    btnCorner.Parent = btn

    local active = false
    btn.MouseButton1Click:Connect(function()
        active = not active
        if active then
            btn.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
            btn.Text = name .. " : ON"
        else
            btn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
            btn.Text = name .. " : OFF"
        end
        callback(active)
    end)
end

-- Pasang Tombol Fitur
CreateButton("Speed Boost", 50, function(state)
    getgenv().ToggleSpeed = state
end)

CreateButton("Auto Rebirth", 93, function(state)
    getgenv().AutoRebirth = state
end)

CreateButton("Anti-AFK", 136, function(state)
